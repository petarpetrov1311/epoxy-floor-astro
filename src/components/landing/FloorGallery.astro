---
const { photos = [] } = Astro.props;
---
{photos.length > 0 && <section id="galeria" class="home-section floor-gallery" aria-labelledby="gallery-heading"><div class="home-container"><h2 id="gallery-heading">Галерия</h2><div class="heading-rule"></div><div class="gallery-grid">{photos.map(photo => <figure><a href={photo.src} aria-label={`Отворете снимката: ${photo.alt}`}><img src={photo.thumb || photo.src} width={photo.tw || photo.w} height={photo.th || photo.h} alt={photo.alt} loading="lazy" decoding="async" /></a></figure>)}</div></div></section>}
<style>
 .floor-gallery { background: #F3F5F6; }
 .gallery-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
 figure { min-width: 0; }
 a { display: block; border-radius: 4px; overflow: hidden; transition: box-shadow 180ms ease-in-out; }
 a:hover { box-shadow: 0 8px 22px rgb(26 26 46 / .16); }
 img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
 @media(max-width: 1023px) { .gallery-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
 @media(max-width: 479px) { .gallery-grid { grid-template-columns: 1fr; } }
</style>
