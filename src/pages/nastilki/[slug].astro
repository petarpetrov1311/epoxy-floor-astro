---
import ServicePage from '../../components/pages/ServicePage.jsx';
import Layout from '../../layouts/Layout.astro';

const services = {
  'hranitelno-vkusova': {
    title: 'Хранително-вкусова промишленост', image: 'https://www.epoxy-fl.com/wp-content/uploads/2022/12/about-us1.jpg',
    description: 'Епоксидните настилки за хранително-вкусовата промишленост отговарят на най-строгите хигиенни и технологични изисквания. Прилагаме ги в месопреработката, млекопреработката, хлебарството, сладкарството и производството на напитки.',
    points: ['Пълно съответствие с изискванията НАССР', 'Устойчивост на мазнини, киселини и дезинфектанти', 'Антибактериални свойства', 'Лесно почистване и дезинфекция', 'Безшевна повърхност без пори', 'Устойчивост на температурни разлики'],
  },
  'proizvodstva-i-skladove': {
    title: 'Производства и складове', image: 'https://www.epoxy-fl.com/wp-content/uploads/2022/12/oborudvane1.jpg',
    description: 'Предлагаме подови настилки за всякакъв вид производствена и складова дейност. Тежки, индустриални, химично и топлоустойчиви подове за всяка индустрия.',
    points: ['Висока механична и ударна якост', 'Устойчивост на масла и химикали', 'Подходящи за вилични кари и тежка техника', 'Антистатични варианти при нужда', 'Бързо изпълнение с минимален престой', 'Гаранция 5–10 години'],
  },
  'parking-i-garaji': {
    title: 'Паркинги и гаражи', image: 'https://www.epoxy-fl.com/wp-content/uploads/2022/12/parking.jpg',
    description: 'Нашите настилки за паркинги и гаражи са проектирани за интензивно автомобилно движение. Лесно се почистват, не се хлъзгат и са устойчиви на масло и петролни продукти.',
    points: ['Устойчивост на масло и петролни продукти', 'Противохлъзгащи свойства', 'Лесно почистване', 'Маркировки в неограничена цветова гама', 'Устойчивост на UV лъчение', 'Подходящи за открити и закрити паркинги'],
  },
  'terasi-i-hidroizolacii': {
    title: 'Тераси и хидроизолации', image: 'https://www.epoxy-fl.com/wp-content/uploads/2022/12/oborudvane2.jpg',
    description: 'Гумираната хидроизолационна система за открити площи е разработена за тераси, балкони и покриви. Тя осигурява трайна водонепропускливост и естетичен вид.',
    points: ['Устойчивост на атмосферни влияния', 'Водонепропускливост', 'Устойчивост на UV лъчение', 'Голяма температурна амплитуда', 'Противохлъзгащи варианти', 'Подходящи за тераси, балкони и покриви'],
  },
  dekorativni: {
    title: 'Декоративни настилки', image: 'https://www.epoxy-fl.com/wp-content/uploads/2022/12/about-us2.jpg',
    description: 'Декоративните епоксидни настилки съчетават висока функционалност с изключителен естетичен вид. Подходящи са за офиси, магазини, заведения, хотели, домове и вили.',
    points: ['Богата цветова палитра', 'Различни завършвания — мат, сатен, гланц', 'Лесно почистване и поддръжка', 'Подходящи за жилищни и търговски обекти', 'Висока химическа устойчивост', 'Безшевна, хигиенична повърхност'],
  },
  mnogoslojni: {
    title: 'Многослойни епоксидни настилки', image: 'https://www.epoxy-fl.com/wp-content/uploads/2026/02/IMG_3147-1-scaled.jpeg',
    description: 'Многослойната безфугова настилка от епоксидна смола съчетава висока механична якост, отлична химическа устойчивост и дълъг експлоатационен живот.',
    points: ['Висока механична здравина', 'Отлична химическа устойчивост', 'Дълъг експлоатационен живот', 'Безфугова повърхност', 'Подходяща за интензивна употреба', 'Материали от Германия и Холандия'],
  },
  'terasi-i-ploski-pokrivi': { title: 'Тераси и плоски покриви', image: '/images/projects/kashta-za-gosti-1.jpg', description: 'Надеждни системи за хидроизолация и защита на открити площи.', points: ['Водонепропускливост', 'UV устойчивост', 'Дълъг експлоатационен живот'] },
  'dvor-i-otkriti-chasti': { title: 'Двор и открити части', image: '/images/projects/oborudvane2.jpg', description: 'Устойчиви настилки за външни площи.', points: ['Устойчивост на атмосферни влияния', 'Противохлъзгаща повърхност', 'Лесна поддръжка'] },
  'igrishta-i-sportni-saorazhenia': { title: 'Игрища и спортни съоръжения', image: '/images/projects/parking.jpg', description: 'Специализирани настилки и маркировки за спортни площи.', points: ['Износоустойчивост', 'Безопасност', 'Цветови решения'] },
  mortel: { title: 'Мортел', image: '/images/projects/img-3147-1-scaled.jpeg', description: 'Здрави и износоустойчиви подови системи за натоварени обекти.', points: ['Висока механична здравина', 'Устойчивост на износване', 'Практичен завършек'] },
  'mandri-i-klanici': { title: 'Мандри и кланици', image: '/images/projects/about-us1.jpg', description: 'Хигиенични настилки за хранително-вкусови производства.', points: ['Лесна дезинфекция', 'Химическа устойчивост', 'Безшевна повърхност'] },
};

export function getStaticPaths() {
  return [
    'hranitelno-vkusova',
    'proizvodstva-i-skladove',
    'parking-i-garaji',
    'terasi-i-hidroizolacii',
    'terasi-i-ploski-pokrivi',
    'dvor-i-otkriti-chasti',
    'igrishta-i-sportni-saorazhenia',
    'mortel',
    'mandri-i-klanici',
    'dekorativni',
    'mnogoslojni',
  ].map((slug) => ({ params: { slug } }));
}

const service = services[Astro.params.slug];
---

<Layout title={`${service.title} | Epoxy Floors`}>
  <ServicePage service={service} client:load />
</Layout>
