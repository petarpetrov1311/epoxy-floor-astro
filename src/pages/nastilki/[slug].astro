---
import ServicePageLayout from '../../components/landing/ServicePageLayout.jsx';
import MobileServiceGallery from '../../components/landing/MobileServiceGallery.jsx';
import PhotoThumbnailSlider from '../../components/landing/PhotoThumbnailSlider.jsx';
import Navbar from '../../components/landing/Navbar.astro';
import Footer from '../../components/landing/Footer.jsx';
import Layout from '../../layouts/Layout.astro';

import { services } from '../../data/services.js';

export function getStaticPaths() {
  return [
    'hranitelno-vkusova',
    'proizvodstva-i-skladove',
    'parking-i-garaji',
    'terasi-i-hidroizolacii',
    'terasi-i-ploski-pokrivi',
    'dvor-i-otkriti-chasti',
    'igrishta-i-sportni-saorazhenia',
    'mortel',
    'mandri-i-klanici',
    'dekorativni',
    'mnogoslojni',
  ].map((slug) => ({ params: { slug } }));
}

const service = services[Astro.params.slug];
---

<Layout title={`${service.title} | Epoxy Floors`}>
  <Navbar />
  <ServicePageLayout {...service}>
    <MobileServiceGallery slot="mobileGallery" title={service.title} image={service.image} gallery={service.gallery} client:visible />
    {service.gallery?.length > 0 && <PhotoThumbnailSlider images={service.gallery} altPrefix={service.title} client:visible />}
  </ServicePageLayout>
  <Footer />
</Layout>
