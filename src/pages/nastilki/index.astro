---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/landing/Navbar.astro';
import Footer from '../../components/landing/Footer.jsx';
import { systemLinks, applicationLinks } from '../../data/navigation';
import { ArrowRight } from 'lucide-react';
import '../../styles/home.css';
---
<Layout title="Подови настилки — системи и приложения | EPOXY FLOORS" description="Изберете подова система по вид настилка или по приложение: епоксидни, полиуретанови, PU-цимент, декоративни, ESD, хидроизолации и мортел.">
<Navbar /><main><header class="hub-hero"><div class="home-container"><h1>Подови настилки</h1><div class="hero-actions"><a href="#vid" class="home-button">По вид настилка</a><a href="#prilozhenie" class="home-button secondary">По приложение</a></div></div></header>{[{ id: 'vid', title: 'По вид настилка', links: systemLinks }, { id: 'prilozhenie', title: 'По приложение', links: applicationLinks }].map(group => <section id={group.id} class="home-section"><div class="home-container"><h2>{group.title}</h2><div class="heading-rule"></div><div class="hub-links">{group.links.map(link => <a href={link.href}>{link.label}<ArrowRight size={20} aria-hidden="true" /></a>)}</div></div></section>)}</main><Footer />
</Layout>
<style>
.hub-hero { padding-block: 56px; background: #1A1A2E; color: white; }
h1 { font-size: clamp(34px,4vw,56px); font-weight: 700; }
.hub-links { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
.hub-links a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px; min-height: 80px; border: 1px solid #DCE0E5; border-radius: 4px; font-weight: 600; transition: box-shadow 180ms ease-in-out; }
.hub-links a:hover { box-shadow: 0 6px 18px rgb(26 26 46 / .1); }
svg { color: #F5A824; flex-shrink: 0; }
section:nth-of-type(even) { background: #F3F5F6; }
@media(max-width:1023px){.hub-links{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:639px){.hub-links{grid-template-columns:1fr;}}
</style>
