---
import BlogLayout from '../../layouts/BlogLayout.astro';
import Gallery from '../../components/landing/Gallery.astro';
import { galleryCategories } from '../../data/gallery.js';
export function getStaticPaths() { return galleryCategories.map((category) => ({ params: { categorySlug: category.slug }, props: { category } })); }
const { category } = Astro.props;
---
<BlogLayout title={`${category.title} | Галерия`}><Gallery {category} /></BlogLayout>
