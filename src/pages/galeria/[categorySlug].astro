---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { galleryCategories, galleryProjects } from '../../data/gallery.js';
export function getStaticPaths() { return galleryCategories.map((category) => ({ params: { categorySlug: category.slug }, props: { category } })); }
const { category } = Astro.props;
const photos = galleryProjects.filter((project) => project.category === category.title);
---
<BlogLayout title={`${category.title} | Галерия`}><section class="bg-navy py-16"><div class="mx-auto max-w-7xl px-6"><a href="/galeria" class="text-white/70">← Галерия</a><h1 class="mt-5 text-4xl font-bold text-white">{category.title}</h1></div></section><section class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-6 py-12 md:grid-cols-3">{photos.map((photo) => <figure><img src={photo.image} alt={photo.title} class="aspect-[4/3] w-full rounded-lg object-cover" /><figcaption class="mt-3 font-semibold">{photo.title}</figcaption></figure>)}</section></BlogLayout>
