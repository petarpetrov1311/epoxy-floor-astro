---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { galleryCategories } from '../../data/gallery.js';
---
<BlogLayout title="Галерия | Epoxy Floors"><section class="bg-navy py-16"><div class="mx-auto max-w-7xl px-6"><h1 class="text-4xl font-bold text-white">Галерия</h1></div></section><section class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-6 py-12 md:grid-cols-3">{galleryCategories.map((category) => <a href={`/galeria/${category.slug}`} class="overflow-hidden rounded-lg border border-border bg-white"><img src={category.image} alt={category.title} class="aspect-[4/3] w-full object-cover" /><h2 class="p-5 font-bold text-foreground">{category.title}</h2></a>)}</section></BlogLayout>
