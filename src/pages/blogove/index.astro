---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { blogPosts } from '../../data/blogs.js';
---

<BlogLayout title="Блогове | Epoxy Floors">
  <section class="bg-navy py-16 md:py-24"><div class="mx-auto max-w-7xl px-6 lg:px-8"><h1 class="text-3xl font-bold text-white md:text-5xl">Блогове и съвети</h1><p class="mt-5 max-w-2xl text-white/70">Практични теми за избор, изпълнение и поддръжка на подови настилки.</p></div></section>
  <section class="py-12 md:py-20"><div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-6 md:grid-cols-2 lg:grid-cols-3 lg:px-8">{blogPosts.map((post) => <article class="group overflow-hidden rounded-lg border border-border bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl"><a href={`/blogove/${post.slug}`} class="block h-full"><img src={post.image} alt={post.title} class="aspect-[4/3] w-full object-cover" loading="lazy" /><div class="p-5"><span class="text-xs font-bold text-primary">{post.category} · {post.readTime} четене</span><h2 class="mt-3 text-lg font-bold text-foreground group-hover:text-primary">{post.title}</h2><p class="mt-3 text-sm text-muted-foreground">{post.excerpt}</p><span class="mt-5 block text-sm font-bold text-primary">Прочети повече →</span></div></a></article>)}</div></section>
</BlogLayout>
